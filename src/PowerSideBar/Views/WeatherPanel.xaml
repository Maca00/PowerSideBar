<UserControl x:Class="PowerSideBar.Views.WeatherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PowerSideBar.Converters"
             xmlns:loc="clr-namespace:PowerSideBar.Services"
             Background="#1A1E26">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:TempToBrushConverter x:Key="TempToBrush"/>

        <!-- Fine rounded wind arrow (points right; rotate via RenderTransform when direction is available) -->
        <Style x:Key="WindArrow" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Data" Value="M1,5 L10.5,5 M7.2,2.2 L12,5 L7.2,7.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,18,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- City name (centered) + refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="{Binding CityName}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="#F2F4F7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Command="{Binding RefreshCommand}"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="6" ToolTip="{loc:Loc common.refresh}">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="#8B93A7"/>
            </Button>
        </Grid>

        <!-- Loading / error -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="{loc:Loc weather.loading}"
                       Foreground="#6B7280" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,4,0,12"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FF6B6B" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,4,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Today hero -->
        <Border Grid.Row="2" Margin="0,0,0,16" CornerRadius="20" Padding="18,20"
                BorderBrush="#28FFFFFF" BorderThickness="1"
                Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2E3644" Offset="0"/>
                    <GradientStop Color="#252B36" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Label + condition -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="{Binding CurrentDateLabel}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#7EB6FF"/>
                    <TextBlock Text="{Binding CurrentDateSubtitle}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#C8D0DC"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Icon + big temps -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Source="{Binding CurrentConditionIcon}"
                               Width="72" Height="72"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentConditionLabel}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#F2F4F7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTemp}"
                                   FontSize="44" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding CurrentTempMaxValue, Converter={StaticResource TempToBrush}}"/>
                        <TextBlock Text="{Binding CurrentTempMin}"
                                   FontSize="20" FontWeight="Medium"
                                   HorizontalAlignment="Right"
                                   Margin="0,-2,0,0"
                                   Foreground="{Binding CurrentTempMinValue, Converter={StaticResource TempToBrush}, ConverterParameter=Min}"/>
                    </StackPanel>
                </Grid>

                <!-- Wind / gusts / rain chips -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                    <Border Background="#1A1E26" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource WindArrow}" Stroke="#6BA3D6"
                                  Margin="0,0,7,0"
                                  RenderTransformOrigin="0.5,0.5"
                                  ToolTip="{Binding CurrentWind}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding CurrentWindArrowAngle}"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{Binding CurrentWind}" FontSize="13"
                                       Foreground="#D0D6E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A1E26" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc weather.gusts}" FontSize="12" Foreground="#E8A44A"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CurrentWindGusts}" FontSize="13"
                                       Foreground="#D0D6E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A1E26" CornerRadius="8" Padding="10,6"
                            Visibility="{Binding HasCurrentPrecipitation, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10" Height="12" Stretch="Uniform"
                                  Fill="#5BA3E0" VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Data="M6,0 C6,0 0,7.5 0,10.5 A6,5.5 0 0 0 12,10.5 C12,7.5 6,0 6,0 Z"/>
                            <TextBlock Text="{Binding CurrentPrecipitation}" FontSize="13"
                                       Foreground="#5BA3E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Upcoming days as cards -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc weather.next_days}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Margin="4,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Forecasts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252A34" CornerRadius="16"
                                    BorderBrush="#28FFFFFF" BorderThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ConditionIcon}"
                                           Width="42" Height="42" VerticalAlignment="Center"
                                           Margin="0,0,14,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayName}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#F2F4F7"/>
                                        <TextBlock Text="{Binding ConditionLabel}"
                                                   FontSize="13" Foreground="#8B93A7"
                                                   Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#1A1E26" CornerRadius="8"
                                                    Padding="8,4" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource WindArrow}" Stroke="#8B93A7"
                                                          Width="12" Height="9"
                                                          Margin="0,0,5,0"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="{Binding WindArrowAngle}"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <TextBlock FontSize="12" Foreground="#AAB2C0"
                                                               Text="{Binding WindSpeedMax, StringFormat='{}{0:0} km/h'}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1A1E26" CornerRadius="8" Padding="8,4"
                                                    Visibility="{Binding HasPrecipitation, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="9" Height="11" Stretch="Uniform"
                                                          Fill="#5BA3E0" VerticalAlignment="Center"
                                                          Margin="0,0,5,0"
                                                          Data="M6,0 C6,0 0,7.5 0,10.5 A6,5.5 0 0 0 12,10.5 C12,7.5 6,0 6,0 Z"/>
                                                    <TextBlock Text="{Binding PrecipitationText}"
                                                               FontSize="12" Foreground="#5BA3E0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" MinWidth="40">
                                        <TextBlock FontSize="22" FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding TempMax, StringFormat='{}{0:0}°'}"
                                                   Foreground="{Binding TempMax, Converter={StaticResource TempToBrush}}"/>
                                        <TextBlock FontSize="14" FontWeight="Medium"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding TempMin, StringFormat='{}{0:0}°'}"
                                                   Foreground="{Binding TempMin, Converter={StaticResource TempToBrush}, ConverterParameter=Min}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
