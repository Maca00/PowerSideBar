<Window x:Class="PowerSideBar.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PowerSideBar.Converters"
        xmlns:local="clr-namespace:PowerSideBar.Views"
        xmlns:loc="clr-namespace:PowerSideBar.Services"
        Title="PowerSideBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#1E1E1E"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:PathToImageConverter x:Key="PathToImage"/>
        <converters:FirstCharConverter x:Key="FirstChar"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>

        <!-- Icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shortcut icon button style -->
        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nav bar button -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="MiniSpotifyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="#434345" BorderThickness="1,0,0,0">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Content panel -->
            <ColumnDefinition x:Name="ContentColumn" Width="*"/>
            <!-- Icon strip (width applied from config on load / settings save) -->
            <ColumnDefinition x:Name="IconStripColumn" Width="50"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Content Panel ===== -->
        <Border x:Name="ContentPanel" Grid.Column="0" Background="#2B2B2B"
                Visibility="Collapsed">
            <DockPanel>
                <!-- Resize grip: left edge when docked right, right edge when docked left -->
                <Border x:Name="ResizeGripLeft" DockPanel.Dock="Left" Width="4" Background="Transparent" Cursor="SizeWE"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
                <Border x:Name="ResizeGripRight" DockPanel.Dock="Right" Width="4" Background="Transparent" Cursor="SizeWE"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>

                <!-- Navigation bar at bottom (hidden for built-in panels) -->
                <Border x:Name="NavBar" DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="4,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource NavButtonStyle}" Click="BtnBack_Click" ToolTip="{loc:Loc sidebar.back}">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Foreground="#CCCCCC"/>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="BtnForward_Click" ToolTip="{loc:Loc sidebar.forward}">
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="#CCCCCC"/>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="BtnHome_Click" ToolTip="{loc:Loc sidebar.home}">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="#CCCCCC"/>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="BtnRefresh_Click" ToolTip="{loc:Loc sidebar.refresh}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="#CCCCCC"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Content area: WebView2 tabs + built-in panels stacked -->
                <Grid Background="#2B2B2B">
                    <Grid x:Name="WebViewContainer"/>
                    <local:WeatherPanel x:Name="WeatherPanelInstance" Visibility="Collapsed"/>
                    <local:HuePanel x:Name="HuePanelInstance" Visibility="Collapsed"/>
                    <local:ShutterPanel x:Name="ShutterPanelInstance" Visibility="Collapsed"/>
                    <local:SpotifyPanel x:Name="SpotifyPanelInstance" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Icon Strip ===== -->
        <Border x:Name="IconStripPanel" Grid.Column="1" Background="#1E1E1E">
            <DockPanel LastChildFill="True">
                <!-- Bottom buttons: Spotify tab shortcut + Add -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <!-- Open Spotify panel (tab) -->
                    <Button x:Name="BtnSpotifyTab" Style="{StaticResource IconButtonStyle}"
                            Click="BtnSpotifyTab_Click" ToolTip="{loc:Loc sidebar.spotify}">
                        <Image Width="24" Height="24"
                               Source="pack://application:,,,/Assets/Icons/spotify.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <!-- Add shortcut -->
                    <Button x:Name="BtnAdd" Style="{StaticResource IconButtonStyle}"
                            Click="BtnAdd_Click" ToolTip="{loc:Loc sidebar.add_shortcut}">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Settings -->
                    <Button x:Name="BtnSettings" Style="{StaticResource IconButtonStyle}"
                            Click="BtnSettings_Click" ToolTip="{loc:Loc sidebar.settings}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Spotify Mini Player (Vertical) -->
                <Border x:Name="SpotifyMiniBar" DockPanel.Dock="Bottom" Background="#0F0F0F" BorderThickness="0" Padding="2" Margin="0,4,0,0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <!-- Album art (with placeholder). Image must sit above placeholder (ZIndex). -->
                        <Grid Width="40" Height="40" Margin="0,0,0,2" ClipToBounds="True">
                            <Border x:Name="SpotifyMiniPlaceholder" Background="#2A2A2A" CornerRadius="4"
                                    Panel.ZIndex="0">
                                <TextBlock Text="♪" Foreground="#666666" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="SpotifyMiniArt" Stretch="UniformToFill"
                                   Width="40" Height="40"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   Panel.ZIndex="1"/>
                        </Grid>

                        <!-- Scrolling title / artist: Canvas so TextBlock measures at full string width; a lone Border(40) constrains layout and clips glyphs before RenderTransform. -->
                        <Border Width="40" Height="15" ClipToBounds="True" Margin="0,0,0,1">
                            <Canvas Width="40" Height="15" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="SpotifyMiniTitle" Canvas.Left="0" Canvas.Top="1"
                                           Text="" FontSize="10" Foreground="#DDDDDD"
                                           TextTrimming="None" TextWrapping="NoWrap"
                                           HorizontalAlignment="Left" RenderTransformOrigin="0,0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="SpotifyMiniTitleScroll" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Border>
                        <Border Width="40" Height="14" ClipToBounds="True" Margin="0,0,0,2">
                            <Canvas Width="40" Height="14" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="SpotifyMiniArtist" Canvas.Left="0" Canvas.Top="1"
                                           Text="" FontSize="9" Foreground="#999999"
                                           TextTrimming="None" TextWrapping="NoWrap"
                                           HorizontalAlignment="Left" RenderTransformOrigin="0,0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="SpotifyMiniArtistScroll" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Border>

                        <!-- Like button -->
                        <Button x:Name="BtnSpotifyLike" Width="40" Height="24" Style="{StaticResource MiniSpotifyButtonStyle}" ToolTip="{loc:Loc sidebar.like}">
                            <TextBlock x:Name="SpotifyLikeIcon" Text="♡" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#CCCCCC" FontWeight="Bold"/>
                        </Button>

                        <!-- Control buttons -->
                        <Button x:Name="BtnSpotifyPrev" Width="40" Height="24" Style="{StaticResource MiniSpotifyButtonStyle}" ToolTip="{loc:Loc sidebar.previous}">
                            <TextBlock Text="&#x23EE;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#1DB954" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="BtnSpotifyPlayPause" Width="40" Height="24" Style="{StaticResource MiniSpotifyButtonStyle}" ToolTip="{loc:Loc sidebar.play_pause}">
                            <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#1DB954" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="BtnSpotifyNext" Width="40" Height="24" Style="{StaticResource MiniSpotifyButtonStyle}" ToolTip="{loc:Loc sidebar.next}">
                            <TextBlock Text="&#x23ED;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#1DB954" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Shortcut icons list (mixed: group headers + shortcuts) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,4,0,0">
                    <ItemsControl x:Name="ShortcutsList" ItemsSource="{Binding DisplayItems}">
                        <ItemsControl.ItemTemplateSelector>
                            <converters:SidebarItemTemplateSelector>
                                <!-- Group header template -->
                                <converters:SidebarItemTemplateSelector.GroupTemplate>
                                    <DataTemplate>
                                        <Border Height="22" Margin="2,8,2,2" Cursor="Hand"
                                                Background="Transparent"
                                                ToolTip="{Binding Name}"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="GroupHeader_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="GroupHeader_PreviewMouseMove"
                                                MouseLeftButtonUp="GroupHeader_Click"
                                                DragOver="GroupHeader_DragOver"
                                                DragLeave="GroupHeader_DragLeave"
                                                Drop="GroupHeader_Drop">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Loc menu.rename_group}" Click="MenuRenameGroup_Click"/>
                                                    <MenuItem Header="{loc:Loc menu.delete_group}" Click="MenuDeleteGroup_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Border Height="1" Background="#3E3E3E" VerticalAlignment="Center"/>
                                                <Border Background="#1E1E1E" HorizontalAlignment="Center"
                                                        Padding="6,1" CornerRadius="3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                                   Foreground="#666666" VerticalAlignment="Center"
                                                                   Margin="0,0,3,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                            <Setter Property="Text" Value="&#xE76C;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstChar}}"
                                                                   Foreground="#888888" FontSize="10" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </converters:SidebarItemTemplateSelector.GroupTemplate>

                                <!-- Shortcut button template -->
                                <converters:SidebarItemTemplateSelector.ShortcutTemplate>
                                    <DataTemplate>
                                        <StackPanel AllowDrop="True"
                                                    DragOver="ShortcutDrop_DragOver"
                                                    DragLeave="ShortcutDrop_DragLeave"
                                                    Drop="ShortcutDrop_Drop">
                                            <!-- Drop indicator: above -->
                                            <Border Height="2" Background="#4ab9f3" CornerRadius="1"
                                                    Margin="8,0" Visibility="Collapsed"
                                                    IsHitTestVisible="False" Tag="DropAbove"/>
                                            <Button Style="{StaticResource ShortcutButtonStyle}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.SelectShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    PreviewMouseLeftButtonDown="Shortcut_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="Shortcut_PreviewMouseMove">
                                                <Button.ContextMenu>
                                                    <ContextMenu Opened="ShortcutContextMenu_Opened">
                                                        <MenuItem Header="{loc:Loc menu.rename}" Click="MenuRename_Click"/>
                                                        <MenuItem Header="{loc:Loc menu.user_agent}">
                                                            <MenuItem x:Name="MenuUaMobile" Header="{loc:Loc menu.ua_mobile}" Click="MenuUaMobile_Click" IsCheckable="True"/>
                                                            <MenuItem x:Name="MenuUaDesktop" Header="{loc:Loc menu.ua_desktop}" Click="MenuUaDesktop_Click" IsCheckable="True"/>
                                                        </MenuItem>
                                                        <MenuItem x:Name="MenuKeepBackground" Header="{loc:Loc menu.keep_background}"
                                                                  IsCheckable="True" Click="MenuKeepBackground_Click"/>
                                                        <MenuItem x:Name="MenuOverlayMode" Header="{loc:Loc menu.overlay}"
                                                                  IsCheckable="True" Click="MenuOverlayMode_Click"/>
                                                        <MenuItem x:Name="MenuCloseOnCollapse" Header="{loc:Loc menu.close_on_collapse}"
                                                                  IsCheckable="True" Click="MenuCloseOnCollapse_Click"
                                                                  ToolTip="{loc:Loc menu.close_on_collapse_tip}"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="MenuMoveToGroup" Header="{loc:Loc menu.move_to_group}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Loc menu.close_tab}" Click="MenuCloseTab_Click"/>
                                                        <MenuItem Header="{loc:Loc menu.delete}" Click="MenuDelete_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid Width="28" Height="28">
                                                    <!-- Fallback: first letter (only when no favicon) -->
                                                    <Border CornerRadius="4" Background="Transparent"
                                                            Width="28" Height="28"
                                                            Visibility="{Binding IconPath, Converter={StaticResource NullOrEmptyToVisibility}}">
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstChar}}"
                                                                   Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Favicon image (on top, hides fallback when loaded) -->
                                                    <Image Width="24" Height="24"
                                                           Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <!-- Tab indicator: open = gray, active = dark+taller -->
                                                    <Border Width="3" CornerRadius="1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Margin="0,0,-4,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Background" Value="#9fa0a4"/>
                                                                <Setter Property="Height" Value="7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsOpen}" Value="True"/>
                                                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background" Value="#4ab9f3"/>
                                                                        <Setter Property="Height" Value="13"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <!-- Drop indicator: below -->
                                            <Border Height="2" Background="#4ab9f3" CornerRadius="1"
                                                    Margin="8,0" Visibility="Collapsed"
                                                    IsHitTestVisible="False" Tag="DropBelow"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </converters:SidebarItemTemplateSelector.ShortcutTemplate>
                            </converters:SidebarItemTemplateSelector>
                        </ItemsControl.ItemTemplateSelector>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
    </Border>
</Window>
