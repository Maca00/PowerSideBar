<UserControl x:Class="PowerSideBar.Views.HuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PowerSideBar.ViewModels"
             xmlns:loc="clr-namespace:PowerSideBar.Services"
             Background="#121212">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Rounded button style -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button (transparent) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hue-style glass pill toggle -->
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="14" Background="#3A3A3C">
                            <Ellipse x:Name="Thumb" Width="22" Height="22"
                                     Fill="#F5F5F5" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hue-app brightness slider: frosted track + fill + white thumb -->
        <Style x:Key="HueTrackButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="28">
                            <Border x:Name="TrackBar" Height="5" CornerRadius="2.5"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HueBrightnessSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Minimum" Value="1"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" MinHeight="32">
                            <Border Height="5" CornerRadius="2.5"
                                    Background="#55FFFFFF"
                                    VerticalAlignment="Center"
                                    Margin="10,0"/>
                            <Track x:Name="PART_Track" Margin="2,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource HueTrackButton}"
                                                  Background="#D9FFFFFF"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="22" Height="22" Fill="#33000000"
                                                             Margin="1,2,0,0"/>
                                                    <Ellipse Width="20" Height="20" Fill="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                                              Direction="270" Opacity="0.45"
                                                                              Color="Black"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource HueTrackButton}"
                                                  Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="4,16,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ══ PAIRING VIEW ══════════════════════════════════════════════════ -->
        <Grid Margin="24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPairing}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE781;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                           Foreground="#3DA6FF" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="Philips Hue" FontSize="22" FontWeight="Bold"
                           Foreground="#F0F0F0" HorizontalAlignment="Center" Margin="0,0,0,36"/>

                <!-- Idle: discover button -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PairingStep}" Value="Idle">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Loc hue.connect_network}"
                               Foreground="#999999" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <Button Content="{loc:Loc hue.search_bridge}"
                            Command="{Binding DiscoverBridgeCommand}"
                            Style="{StaticResource RoundBtn}"
                            Background="#3DA6FF" Foreground="White"
                            FontSize="14" Padding="20,10"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Discovering -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PairingStep}" Value="Discovering">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Loc hue.searching}"
                               Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- BridgeFound -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PairingStep}" Value="BridgeFound">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="#2A2A2A" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc hue.bridge_found}" Foreground="#888888" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding BridgeFoundIp}" FontSize="18" FontWeight="Bold"
                                       Foreground="#3DA6FF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="13" Foreground="#CCCCCC" Margin="0,0,0,24">
                        <Run Text="{loc:Loc hue.press_button_1}"/>
                        <Run Text="{loc:Loc hue.press_button_2}" FontWeight="Bold" Foreground="#3DA6FF"/>
                        <Run Text="{loc:Loc hue.press_button_3}"/>
                    </TextBlock>
                    <Button Content="{loc:Loc hue.connect}" Command="{Binding ConnectCommand}"
                            Style="{StaticResource RoundBtn}"
                            Background="#3DA6FF" Foreground="White"
                            FontSize="14" Padding="20,10" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Connecting -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PairingStep}" Value="Connecting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Loc hue.connecting}" Foreground="#AAAAAA"
                               FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PairingStep}" Value="Error">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Button Content="{loc:Loc hue.retry}" Command="{Binding RetryPairingCommand}"
                            Style="{StaticResource RoundBtn}"
                            Background="#2E2E2E" Foreground="#CCCCCC"
                            FontSize="13" Padding="16,8" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ══ ROOMS LIST ════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRoomsListVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="16,16,12,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}"
                        Command="{Binding RefreshCommand}" ToolTip="{loc:Loc common.refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               FontSize="15" Foreground="#AAAAAA"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}"
                        Command="{Binding StartPairingCommand}" ToolTip="{loc:Loc hue.reconfigure}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#666666"/>
                </Button>
                <TextBlock Text="{loc:Loc hue.home}" FontSize="26" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Loading -->
            <TextBlock Grid.Row="1" Text="{loc:Loc common.loading}" Foreground="#666666" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,8"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Error -->
            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                       Foreground="#FF6B6B" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="16,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Rooms -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,4,14,16">
                    <TextBlock Text="{loc:Loc hue.rooms}" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HueRoomViewModel}">
                                <Border CornerRadius="18" Margin="0,0,0,10"
                                        Cursor="Hand"
                                        Background="{Binding RoomCardBackground}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectRoomCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid Margin="16,14,16,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top: icon + name | toggle -->
                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0"
                                                  Data="{Binding RoomIconPath}"
                                                  Fill="White"
                                                  Width="22" Height="22"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <ToggleButton Grid.Column="2"
                                                          Style="{StaticResource PillToggle}"
                                                          IsChecked="{Binding IsAnyLightOn, Mode=OneWay}"
                                                          Command="{Binding ToggleRoomCommand}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Bottom: brightness slider (always visible like Hue app) -->
                                        <Slider Grid.Row="1"
                                                Style="{StaticResource HueBrightnessSlider}"
                                                Value="{Binding MasterBrightness, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ ROOM DETAIL ═══════════════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRoomDetailVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: back + name + toggle -->
            <Border Grid.Row="0" Background="#1A1A1A" Padding="8,12,16,12">
                <Grid DataContext="{Binding SelectedRoom}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconBtn}"
                            Command="{Binding DataContext.NavigateBackCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="8,4">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#CCCCCC"/>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="8,0"/>

                    <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}"
                                  IsChecked="{Binding IsAnyLightOn, Mode=OneWay}"
                                  Command="{Binding ToggleRoomCommand}"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Master brightness slider -->
            <Border Grid.Row="1" Background="#161616" Padding="16,10,16,14"
                    DataContext="{Binding SelectedRoom}">
                <Slider Style="{StaticResource HueBrightnessSlider}"
                        Value="{Binding MasterBrightness, Mode=TwoWay}"/>
            </Border>

            <!-- Scenes + Lights scrollable content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          DataContext="{Binding SelectedRoom}">
                <StackPanel Margin="12,0,12,16">

                    <!-- Scenes section (visible when scenes exist) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Scenes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{loc:Loc hue.scenes}" Style="{StaticResource SectionLabel}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Hidden"
                                      Margin="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding Scenes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HueSceneViewModel}">
                                        <Button Command="{Binding ActivateCommand}"
                                                BorderThickness="0" Cursor="Hand"
                                                Margin="0,0,8,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="90" Height="90"
                                                            CornerRadius="14"
                                                            Background="{Binding CardBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                                        RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                 Value="True">
                                                                        <Setter Property="Opacity" Value="0.85"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="6,0,6,10"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Lights section -->
                    <TextBlock Text="{loc:Loc hue.lights}" Style="{StaticResource SectionLabel}"/>

                    <ItemsControl ItemsSource="{Binding Lights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HueLightViewModel}">
                                <Border CornerRadius="14" Margin="4" MinHeight="100"
                                        Background="{Binding CardBackground}">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Lamp icon -->
                                        <TextBlock Grid.Row="0" Text="&#xE781;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="26" HorizontalAlignment="Left"
                                                   VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Name -->
                                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,4,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#777777"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Toggle -->
                                        <ToggleButton Grid.Row="2"
                                                      Style="{StaticResource PillToggle}"
                                                      IsChecked="{Binding IsOn, Mode=OneWay}"
                                                      Command="{Binding ToggleCommand}"
                                                      HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
