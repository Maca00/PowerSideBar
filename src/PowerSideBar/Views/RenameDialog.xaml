<Window x:Class="PowerSideBar.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PowerSideBar.Services"
        Title="{loc:Loc dialog.rename}"
        Width="320" Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2B2B">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="TxtName"
                 Background="#3E3E3E" Foreground="White" BorderBrush="#555"
                 Padding="6,4" FontSize="14"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Loc common.cancel}" Click="BtnCancel_Click" IsCancel="True"
                    Background="#3E3E3E" Foreground="#CCCCCC" BorderBrush="#555"
                    Padding="16,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="{loc:Loc common.ok}" Click="BtnOk_Click" IsDefault="True"
                    Background="#0078D4" Foreground="White" BorderBrush="#0078D4"
                    Padding="16,6" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
