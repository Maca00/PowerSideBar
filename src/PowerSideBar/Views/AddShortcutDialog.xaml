<Window x:Class="PowerSideBar.Views.AddShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PowerSideBar.Services"
        Title="{loc:Loc dialog.add_shortcut}"
        Width="380" Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2B2B">

    <Window.Resources>
        <Style x:Key="DialogGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E3E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4A4A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#666666"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A86D9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1A86D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#006CBC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#006CBC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc dialog.name}" Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName"
                 Background="#3E3E3E" Foreground="White" BorderBrush="#555"
                 Padding="6,4" FontSize="14"/>

        <!-- URL -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc dialog.url}" Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtUrl"
                 Background="#3E3E3E" Foreground="White" BorderBrush="#555"
                 Padding="6,4" FontSize="14"
                 />

        <!-- Favicon preview -->
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
            <Image x:Name="FaviconPreview" Width="24" Height="24" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc dialog.browse_icon}" Click="BtnBrowseIcon_Click"
                    Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Loc common.cancel}" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource DialogGhostButton}" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc common.add}" Click="BtnAdd_Click" IsDefault="True"
                    Style="{StaticResource DialogPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
