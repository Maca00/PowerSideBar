<UserControl x:Class="PowerSideBar.Views.SpotifyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PowerSideBar.Converters"
             xmlns:loc="clr-namespace:PowerSideBar.Services"
             Background="#1A1A1A">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SpotifyButton" TargetType="Button">
            <Setter Property="Background" Value="#1DB954"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1ED760"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#1DB954"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="#1A1A1A" LastChildFill="True">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="10,14,10,6">
            <TextBlock Text="{loc:Loc sidebar.spotify}" FontSize="20" FontWeight="Bold" Foreground="#1DB954" TextAlignment="Center"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Margin="10">
            <!-- Not connected state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <TextBlock Text="{loc:Loc spotify.not_connected}" FontSize="14" Foreground="#CCCCCC" TextAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#999999" TextAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap"/>
                <Button Command="{Binding AuthorizeCommand}"
                        Content="{loc:Loc spotify.connect}"
                        Style="{StaticResource SpotifyButton}"
                        IsEnabled="{Binding IsConfigured}"/>
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,12,0,0"
                             Background="#333333" Foreground="#1DB954"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Connected state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">

                <!-- Album art -->
                <Border Width="180" Height="180" Margin="0,0,0,16" CornerRadius="4"
                        Background="#2A2A2A" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="♪" Foreground="#666666" FontSize="52"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding AlbumArtUrl}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- Title -->
                <TextBlock Text="{Binding CurrentTrack, FallbackValue='Nothing playing'}"
                           FontSize="14" FontWeight="Bold" Foreground="White"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" Margin="0,0,0,4"/>

                <!-- Artist -->
                <TextBlock Text="{Binding CurrentArtist}" FontSize="11" Foreground="#CCCCCC"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" Margin="0,0,0,14"/>

                <!-- Progress bar -->
                <ProgressBar Value="{Binding ProgressMs, Mode=OneWay, FallbackValue=0}"
                             Maximum="{Binding DurationMs, FallbackValue=1}"
                             Height="3" Margin="0,0,0,4"
                             Background="#333333" Foreground="#1DB954"/>

                <!-- Time display -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{Binding ProgressText}" Foreground="#999999" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding DurationText}" Foreground="#999999" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Control buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                    <Button Command="{Binding PreviousCommand}" Style="{StaticResource ControlButton}" ToolTip="{loc:Loc sidebar.previous}">
                        <TextBlock Text="⏮" FontSize="18" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" ToolTip="{loc:Loc spotify.playing}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock Text="▶" FontSize="16" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding PauseCommand}" Style="{StaticResource PlayButton}" ToolTip="{loc:Loc spotify.paused}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏸" FontSize="16" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding NextCommand}" Style="{StaticResource ControlButton}" ToolTip="{loc:Loc sidebar.next}">
                        <TextBlock Text="⏭" FontSize="18" Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- Volume -->
                <Grid Margin="0,4,0,6" IsEnabled="{Binding CanControlVolume}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔈" FontSize="14" Foreground="#CCCCCC"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Grid.Column="1"
                            Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10"
                            Foreground="#1DB954"/>
                    <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}"
                               FontSize="10" Foreground="#999999"
                               VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="32"
                               TextAlignment="Right"/>
                </Grid>

                <!-- Active device -->
                <TextBlock Text="{Binding ActiveDeviceLabel}"
                           FontSize="9" Foreground="#888888" TextAlignment="Center" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveDeviceName}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveDeviceName}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#777777"
                           TextAlignment="Center" Margin="0,4"/>

                <!-- Disconnect -->
                <Button Command="{Binding DisconnectCommand}"
                        Content="{loc:Loc spotify.disconnect}"
                        Background="Transparent" Foreground="#999999"
                        BorderThickness="0" FontSize="10" Cursor="Hand"
                        Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
