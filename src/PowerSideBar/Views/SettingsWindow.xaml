<Window x:Class="PowerSideBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PowerSideBar.Services"
        Title="{loc:Loc Key=settings.title}"
        Width="680" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="8,2">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#0078D4"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left" Margin="-14,0,0,0"
                                        Background="#0078D4" CornerRadius="2"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FeatureToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BarWidthRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="#2A2A2A"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="Transparent"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 6 6 L 12 0"
                                                      Stroke="#CCCCCC"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Width="12" Height="6"
                                                      Stretch="None"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#505050"/>
                                                <Setter TargetName="Chrome" Property="Background" Value="#333333"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="10,8,32,8"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#2A2A2A"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="0,2"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#505050"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#454545"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#606060"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A86D9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1A86D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#006CBC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#006CBC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav -->
        <Border Grid.Column="0" Background="#141414" BorderBrush="#252525" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Key=settings.title}"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           Margin="16,20,16,16"/>
                <StackPanel>
                    <Button x:Name="NavGeneral" Content="{loc:Loc Key=settings.nav.general}" Style="{StaticResource NavButtonActiveStyle}"
                            Click="Nav_Click" Tag="general"/>
                    <Button x:Name="NavWeather" Content="{loc:Loc Key=settings.nav.weather}" Style="{StaticResource NavButtonStyle}"
                            Click="Nav_Click" Tag="weather"/>
                    <Button x:Name="NavHue" Content="{loc:Loc Key=settings.nav.hue}" Style="{StaticResource NavButtonStyle}"
                            Click="Nav_Click" Tag="hue"/>
                    <Button x:Name="NavShutters" Content="{loc:Loc Key=settings.nav.shutters}" Style="{StaticResource NavButtonStyle}"
                            Click="Nav_Click" Tag="shutters"/>
                    <Button x:Name="NavSpotify" Content="{loc:Loc Key=settings.nav.spotify}" Style="{StaticResource NavButtonStyle}"
                            Click="Nav_Click" Tag="spotify"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8">
                <Grid>
                    <!-- Général -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="{loc:Loc Key=settings.general.title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Key=settings.general.subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <CheckBox x:Name="ChkAutoStart" Content="{loc:Loc Key=settings.auto_start}"
                                  Style="{StaticResource CheckStyle}"/>
                        <CheckBox x:Name="ChkAdBlock" Content="{loc:Loc Key=settings.ad_block}"
                                  Style="{StaticResource CheckStyle}"/>

                        <TextBlock Text="{loc:Loc Key=settings.language}" Style="{StaticResource FieldLabel}" Margin="0,8,0,10"/>
                        <ComboBox x:Name="CmbLanguage"
                                  Width="200" HorizontalAlignment="Left"
                                  Margin="0,0,0,18"
                                  Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Tag="en" Content="{loc:Loc Key=settings.lang.en}"/>
                            <ComboBoxItem Tag="fr" Content="{loc:Loc Key=settings.lang.fr}"/>
                            <ComboBoxItem Tag="es" Content="{loc:Loc Key=settings.lang.es}"/>
                        </ComboBox>

                        <TextBlock Text="{loc:Loc Key=settings.bar_side}" Style="{StaticResource FieldLabel}" Margin="0,8,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <RadioButton x:Name="RbSideLeft" GroupName="SidebarSide" Content="{loc:Loc Key=settings.side.left}"
                                         Style="{StaticResource BarWidthRadio}"/>
                            <RadioButton x:Name="RbSideRight" GroupName="SidebarSide" Content="{loc:Loc Key=settings.side.right}"
                                         Style="{StaticResource BarWidthRadio}"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Key=settings.bar_width}" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbBarNarrow" GroupName="BarWidth" Content="{loc:Loc Key=settings.width.narrow}"
                                         Style="{StaticResource BarWidthRadio}" Tag="40"/>
                            <RadioButton x:Name="RbBarNormal" GroupName="BarWidth" Content="{loc:Loc Key=settings.width.normal}"
                                         Style="{StaticResource BarWidthRadio}" Tag="50"/>
                            <RadioButton x:Name="RbBarWide" GroupName="BarWidth" Content="{loc:Loc Key=settings.width.wide}"
                                         Style="{StaticResource BarWidthRadio}" Tag="60"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Key=settings.updates}" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                        <TextBlock x:Name="TxtAppVersion" Foreground="#888888" FontSize="12"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="BtnCheckUpdates" Content="{loc:Loc Key=update.check_button}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource GhostButton}"
                                Click="BtnCheckUpdates_Click"/>
                    </StackPanel>

                    <!-- Météo -->
                    <StackPanel x:Name="PageWeather" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=settings.weather.title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Key=settings.weather.subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <CheckBox x:Name="ChkEnableWeather" Content="{loc:Loc Key=settings.weather.enable}"
                                  Style="{StaticResource FeatureToggleStyle}"
                                  Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>

                        <StackPanel x:Name="PanelWeatherFields">
                            <TextBlock x:Name="TxtWeatherCityLabel"
                                       Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc Key=settings.weather.search}"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtWeatherSearch" Style="{StaticResource FieldBox}"
                                     TextChanged="TxtWeatherSearch_TextChanged"/>
                            <TextBlock x:Name="TxtWeatherSearchStatus" Foreground="#888888"
                                       FontSize="11" Margin="0,-6,0,8" TextWrapping="Wrap"/>
                            <ListBox x:Name="LstWeatherResults"
                                     MaxHeight="160"
                                     Margin="0,0,0,4"
                                     Background="#2A2A2A"
                                     BorderBrush="#3A3A3A"
                                     Foreground="White"
                                     Visibility="Collapsed"
                                     DisplayMemberPath="DisplayLabel"
                                     SelectionChanged="LstWeatherResults_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3A3A3A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#0078D4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hue -->
                    <StackPanel x:Name="PageHue" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=settings.hue.title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Key=settings.hue.subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <CheckBox x:Name="ChkEnableHue" Content="{loc:Loc Key=settings.hue.enable}"
                                  Style="{StaticResource FeatureToggleStyle}"
                                  Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>

                        <StackPanel x:Name="PanelHueFields">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Loc Key=settings.hue.ip}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHueIp" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="1" Text="{loc:Loc Key=settings.hue.key}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtHueKey" Style="{StaticResource FieldBox}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Volets -->
                    <StackPanel x:Name="PageShutters" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=settings.shutters.title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Key=settings.shutters.subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <CheckBox x:Name="ChkEnableShutters" Content="{loc:Loc Key=settings.shutters.enable}"
                                  Style="{StaticResource FeatureToggleStyle}"
                                  Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>

                        <StackPanel x:Name="PanelShutterFields">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Loc Key=settings.shutters.host}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtShutterHost" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="1" Text="{loc:Loc Key=settings.shutters.port}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtShutterPort" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="2" Text="{loc:Loc Key=settings.shutters.user}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtShutterUser" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="3" Text="{loc:Loc Key=settings.shutters.password}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="TxtShutterPassword" Style="{StaticResource FieldPassword}"/>
                                <TextBlock Grid.Row="4" Text="{loc:Loc Key=settings.shutters.host_id}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtShutterHostId" Style="{StaticResource FieldBox}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Spotify -->
                    <StackPanel x:Name="PageSpotify" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=settings.spotify.title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Key=settings.spotify.subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <CheckBox x:Name="ChkEnableSpotify" Content="{loc:Loc Key=settings.spotify.enable}"
                                  Style="{StaticResource FeatureToggleStyle}"
                                  Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>

                        <StackPanel x:Name="PanelSpotifyFields">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Loc Key=settings.spotify.client_id}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSpotifyClientId" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="1" Text="{loc:Loc Key=settings.spotify.client_secret}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TxtSpotifyClientSecret" Style="{StaticResource FieldPassword}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" Background="#141414" BorderBrush="#252525" BorderThickness="0,1,0,0"
                    Padding="28,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Key=common.cancel}" Click="BtnCancel_Click" IsCancel="True"
                            Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                    <Button Content="{loc:Loc Key=common.save}" Click="BtnSave_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
