<UserControl x:Class="PowerSideBar.Views.ShutterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PowerSideBar.Services"
             Background="#121212">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Circular control button (up / down) -->
        <Style x:Key="CtrlBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                BorderBrush="#28FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A40"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A4A52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop accent -->
        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource CtrlBtn}">
            <Setter Property="Background" Value="#3A2E1A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E3C20"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#634C28"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Wide control for "all shutters" hero -->
        <Style x:Key="WideCtrlBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#28FFFFFF" BorderThickness="1"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A40"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A4A52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WideStopBtn" TargetType="Button" BasedOn="{StaticResource WideCtrlBtn}">
            <Setter Property="Background" Value="#3A2E1A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E3C20"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#634C28"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="4,16,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- Connecting -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Connecting">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                       Foreground="#7EB6FF" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="{loc:Loc shutters.connecting}" Foreground="#A0A0A0"
                       FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                       Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,20"/>
            <Button Style="{StaticResource WideCtrlBtn}"
                    Command="{Binding ConnectCommand}"
                    HorizontalAlignment="Center" Width="160" Content="{loc:Loc shutters.reconnect}"/>
        </StackPanel>

        <!-- Connected -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Connected">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="16,16,12,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}"
                        Command="{Binding RefreshCommand}" ToolTip="{loc:Loc common.refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               FontSize="15" Foreground="#AAAAAA"/>
                </Button>
                <TextBlock Text="{loc:Loc shutters.title}" FontSize="26" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,4,14,16">

                    <!-- Hero: all shutters -->
                    <TextBlock Text="{loc:Loc shutters.all}" Style="{StaticResource SectionLabel}"/>
                    <Border CornerRadius="18" Padding="16,16" Margin="0,0,0,4"
                            BorderBrush="#28FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2E3644" Offset="0"/>
                                <GradientStop Color="#252B36" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource WideCtrlBtn}"
                                    Command="{Binding AllUpCommand}" ToolTip="{loc:Loc shutters.all_up}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="White"
                                          Data="M6,0 L12,10 L8,10 L8,16 L4,16 L4,10 L0,10 Z"
                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc shutters.up}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource WideStopBtn}"
                                    Command="{Binding AllStopCommand}" ToolTip="{loc:Loc shutters.all_stop}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="10" Height="10" Background="#E8A44A"
                                            CornerRadius="1.5" Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc shutters.stop}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource WideCtrlBtn}"
                                    Command="{Binding AllDownCommand}" ToolTip="{loc:Loc shutters.all_down}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="White"
                                          Data="M4,0 L8,0 L8,6 L12,6 L6,16 L0,6 L4,6 Z"
                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc shutters.down}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Individual shutters by floor (grouped by channel) -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc shutters.ground_floor}" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource WideCtrlBtn}"
                                Padding="14,0" MinWidth="110"
                                Command="{Binding GroundFloorDownCommand}"
                                ToolTip="{loc:Loc shutters.close_gf_tip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" Fill="White"
                                      Data="M4,0 L8,0 L8,6 L12,6 L6,16 L0,6 L4,6 Z"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc shutters.close_floor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding GroundFloorDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252A34" CornerRadius="16"
                                        BorderBrush="#28FFFFFF" BorderThickness="1"
                                        Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{loc:Loc shutters.sending}" Foreground="#7EB6FF"
                                                       FontSize="11" Margin="0,6,0,0"
                                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource CtrlBtn}"
                                                    Command="{Binding UpCommand}"
                                                    ToolTip="{loc:Loc shutters.up}" Margin="0,0,8,0">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                                                      Data="M6,0 L12,10 L8,10 L8,16 L4,16 L4,10 L0,10 Z"/>
                                            </Button>
                                            <Button Style="{StaticResource StopBtn}"
                                                    Command="{Binding StopCommand}"
                                                    ToolTip="{loc:Loc shutters.stop}" Margin="0,0,8,0">
                                                <Border Width="12" Height="12" Background="#E8A44A"
                                                        CornerRadius="2"/>
                                            </Button>
                                            <Button Style="{StaticResource CtrlBtn}"
                                                    Command="{Binding DownCommand}"
                                                    ToolTip="{loc:Loc shutters.down}">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                                                      Data="M4,0 L8,0 L8,6 L12,6 L6,16 L0,6 L4,6 Z"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc shutters.floor}" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource WideCtrlBtn}"
                                Padding="14,0" MinWidth="110"
                                Command="{Binding UpperFloorDownCommand}"
                                ToolTip="{loc:Loc shutters.close_floor_tip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" Fill="White"
                                      Data="M4,0 L8,0 L8,6 L12,6 L6,16 L0,6 L4,6 Z"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc shutters.close_floor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding UpperFloorDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252A34" CornerRadius="16"
                                        BorderBrush="#28FFFFFF" BorderThickness="1"
                                        Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{loc:Loc shutters.sending}" Foreground="#7EB6FF"
                                                       FontSize="11" Margin="0,6,0,0"
                                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource CtrlBtn}"
                                                    Command="{Binding UpCommand}"
                                                    ToolTip="{loc:Loc shutters.up}" Margin="0,0,8,0">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                                                      Data="M6,0 L12,10 L8,10 L8,16 L4,16 L4,10 L0,10 Z"/>
                                            </Button>
                                            <Button Style="{StaticResource StopBtn}"
                                                    Command="{Binding StopCommand}"
                                                    ToolTip="{loc:Loc shutters.stop}" Margin="0,0,8,0">
                                                <Border Width="12" Height="12" Background="#E8A44A"
                                                        CornerRadius="2"/>
                                            </Button>
                                            <Button Style="{StaticResource CtrlBtn}"
                                                    Command="{Binding DownCommand}"
                                                    ToolTip="{loc:Loc shutters.down}">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                                                      Data="M4,0 L8,0 L8,6 L12,6 L6,16 L0,6 L4,6 Z"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
